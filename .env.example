APP_NAME=SmackChat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SUPPORT_EMAIL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=smackchat
DB_USERNAME=smackchat
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PRIMEVUE_LICENSE_KEY=

ABLY_KEY=
VAPID_SUBJECT=mailto:notifications@smack.chat
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
SMACKCHAT_RETENTION_DAYS=90
SMACKCHAT_ARCHIVE_PRICE_CENTS=700
SMACKCHAT_AUDIT_RETENTION_DAYS=365
SMACKCHAT_ATTENDANCE_RETENTION_DAYS=0
SMACKCHAT_CALL_GROUP_LIMIT=8
SMACKCHAT_CALL_RING_SECONDS=75
SMACKCHAT_CALL_ICE_SERVERS=stun:stun.l.google.com:19302
SMACKCHAT_CALL_TURN_URL=
SMACKCHAT_CALL_TURN_USERNAME=
SMACKCHAT_CALL_TURN_CREDENTIAL=

# Native app push (all optional; missing keys skip that kind of push).
# Expo token is only needed when Expo "enhanced push security" is on.
EXPO_ACCESS_TOKEN=
# iOS call ringing (PushKit VoIP over APNs, .p8 auth key)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
# Android call ringing (FCM HTTP v1, service account JSON)
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# Hosted TURN for calls (Cloudflare Realtime); see PRODUCTION.md
SMACKCHAT_CALL_CLOUDFLARE_TURN_KEY_ID=
SMACKCHAT_CALL_CLOUDFLARE_TURN_TOKEN=
